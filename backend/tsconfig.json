{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": "./src",
    "paths": {
      "@model/*": ["models/*"],
      "@controllers/*": ["api/controllers/*"],
      "@middlewares/*": ["api/middlewares/*"],
      "@routes/*": ["api/routes/*"],
      "@services/*": ["services/*"],
      "@api/*": ["api/*"],
      "@config/*": ["config/*"],
      "@utils/*": ["utils/*"],
      "@type/*": ["types/*"]
    }
  },
  "include": [ "src/**/*"],
  "exclude": [ "node_modules", "dist", "jest.config.js", "**/*.test.ts" ]
}