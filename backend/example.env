# QUICK SETUP:
# 1. Generate JWT secrets: openssl rand -hex 32
# 2. For Gmail: Enable 2FA → App passwords → Generate 16-char password
# 3. Update EMAIL_USER and EMAIL_PASS with your Gmail credentials

MONGODB_URI=mongodb://localhost:27017/dockchain
ALLOWED_ORIGINS=http://localhost:3000
PORT=4000
JWT_ACCESS_SECRET=your_super_secure_access_secret_key_32_chars
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_key_32_chars
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-character-app-password